{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    /* CONSTITUTION.md §5.1: no ../../../ in imports. */
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  /* `*.test.kit.ts` is test support — the scenario sandbox and emulator. The
     infix keeps it out of the image, and the guards read `.test.` as test code. */
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.*.ts"]
}
