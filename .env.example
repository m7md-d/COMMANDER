# Copy to .env before `docker compose up`. Never commit .env.
# Every variable here is validated at boot by apps/api/src/config/env.ts —
# a missing or malformed value fails the process immediately by design.

# ---------- database ----------
POSTGRES_USER=commander
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=commander
# Host/port refer to the compose service name, not localhost.
DATABASE_URL=postgresql://commander:change-me-in-production@postgres:5432/commander?schema=public

# ---------- api ----------
NODE_ENV=production
API_PORT=4000
# Where the browser reaches the panel. Used for cookie and CORS decisions.
# In a public deployment behind Caddy (docker-compose.public.yml) set this to
# your real HTTPS domain, e.g. https://commander.duckdns.org — it also drives the
# webhook URL shown on the setup page.
PUBLIC_URL=http://localhost:8080

# Panel login password.
DASHBOARD_PASSWORD=change-me

# Signs session cookies. openssl rand -hex 32
SESSION_SECRET=

# Shared with GitHub's webhook settings. openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ---------- integrations ----------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Fallback channel for repositories with no webhook of their own.
DISCORD_WEBHOOK_URL=

# ---------- github app (optional) ----------
# Enables the three enrichment features: per-file line attribution, "who
# touched this line", and quoting the watched repo's own constitution.
# Leave both empty and the dossier still works — it just reports the data as
# unavailable instead of inventing it. See README "Connecting the GitHub App".
#
# GITHUB_APP_ID: the numeric App ID on the app's settings page.
GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY: contents of the downloaded .pem. Either paste it with
# literal \n escapes on one line, or base64 the whole file — both are accepted.
GITHUB_APP_PRIVATE_KEY=

# ---------- web ----------
# Local dev: 8080. Behind Caddy or the Cloudflare Tunnel in production, bind to
# localhost only so nothing but the overlay reaches web: WEB_PORT=127.0.0.1:8080
WEB_PORT=8080
# Panel language on first load: ar | en
DEFAULT_LOCALE=ar

# ---------- public deployment ----------
# Two mutually exclusive ways to go public. Pick ONE overlay.
#
# A) Caddy (docker-compose.public.yml): opens ports 80/443, gets its own
#    Let's Encrypt cert. Needs a domain (DuckDNS works) and open inbound ports.
#    PUBLIC_DOMAIN is the bare host Caddy certifies — must equal PUBLIC_URL's host
#    (no scheme, no path), e.g. commander.duckdns.org. Empty in local dev.
PUBLIC_DOMAIN=
#
# B) Cloudflare Tunnel (docker-compose.tunnel.yml): opens NO inbound port;
#    cloudflared dials out to Cloudflare, which terminates TLS. Needs a domain on
#    Cloudflare. Leave PUBLIC_DOMAIN empty and set TUNNEL_TOKEN from the Zero
#    Trust dashboard (Networks -> Tunnels). See docs/DEPLOY-TUNNEL.md.
TUNNEL_TOKEN=
#
# Optional: let `docker compose` include an overlay automatically, so you can run
# a plain `docker compose up -d --build` on the server. Pick the matching line.
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml

# ---------- dev only ----------
# Host port for postgres under docker-compose.dev.yml.
POSTGRES_HOST_PORT=5433
