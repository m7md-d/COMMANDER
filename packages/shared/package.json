{
  "name": "@commander/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n/ar": {
      "types": "./dist/i18n/ar.d.ts",
      "default": "./dist/i18n/ar.js"
    },
    "./i18n/en": {
      "types": "./dist/i18n/en.d.ts",
      "default": "./dist/i18n/en.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
